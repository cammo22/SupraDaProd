{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "@webgpu/types"],
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "onnxruntime-common": ["./node_modules/ort/node_modules/onnxruntime-common"] }
  },
  "include": ["src", "tests/unit", "vite.config.ts"]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SupraDaProd",
  "version": "1.0.2",
  "identifier": "com.daprod.supradaprod",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SupraDaProd",
        "width": 1100,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "backgroundColor": "#07070f"
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data:; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https: http:",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Text-to-image on your device — type it or say it.",
    "longDescription": "SupraDaProd generates images from text or your voice, fully on-device, with the 104M-parameter Supra2-IMG model. No server, no account, no subscription.",
    "copyright": "© 2026 cammo22 — MIT License",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "SupraDaProd"
      },
      "wix": {
        "language": ["it-IT", "en-US"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] }
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}

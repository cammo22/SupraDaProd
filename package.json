{
  "name": "supradaprod",
  "private": true,
  "version": "2.0.0",
  "description": "Text-to-image studio on your device — Supra2-IMG and DreamShaper 8 (ONNX, WebGPU/WASM), fully offline.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e/run.mjs",
    "tauri": "tauri",
    "icons": "node scripts/make-icon.mjs && tauri icon app-icon.png"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@noble/hashes": "^1.8.0",
    "@tauri-apps/api": "^2.9.0",
    "ort": "npm:onnxruntime-web@1.30.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.9.6",
    "@webgpu/types": "^0.1.74",
    "jsdom": "^27.4.0",
    "playwright-core": "^1.56.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.11",
    "vitest": "^3.2.4"
  }
}
